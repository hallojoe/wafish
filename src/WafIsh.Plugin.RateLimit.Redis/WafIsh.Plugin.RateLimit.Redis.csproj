  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WafIsh.Plugin.Abstractions\WafIsh.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\WafIsh\WafIsh.csproj" />
  </ItemGroup>

</Project>
