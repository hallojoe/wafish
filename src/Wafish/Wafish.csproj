<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Wafish</PackageId>
    <Description>YARP gateway base library: dynamic route registration, auto-registration, and config management.</Description>
    <PackageTags>yarp;reverse-proxy;gateway;api-gateway;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wafish.Client\Wafish.Client.csproj" />
    <ProjectReference Include="..\Wafish.Grpc\Wafish.Grpc.csproj" />
    <ProjectReference Include="..\Wafish.Plugin.Abstractions\Wafish.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Wafish.Storage.Abstractions\Wafish.Storage.Abstractions.csproj" />
  </ItemGroup>

</Project>
