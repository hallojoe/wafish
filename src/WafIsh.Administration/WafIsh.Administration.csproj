<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Gateway administration APIs, authentication, and realtime services without Razor presentation.</Description>
    <PackageTags>yarp;gateway;administration;api;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../WafIsh.Runtime/WafIsh.Runtime.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/I18n/en-US/*.json" LogicalName="WafIsh.Dashboard.Infrastructure.I18n.en_US.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
