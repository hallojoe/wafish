<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Wafish.Storage.Sqlite</PackageId>
    <Description>SQLite storage implementation for Wafish.</Description>
    <PackageTags>yarp;reverse-proxy;gateway;storage;sqlite;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wafish.Regression" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wafish.Storage.Abstractions\Wafish.Storage.Abstractions.csproj" />
  </ItemGroup>

</Project>
