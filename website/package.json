{
  "name": "@wafish/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run assets && astro dev --host 127.0.0.1",
    "assets": "node scripts/brand.mjs",
    "build": "npm run assets && astro build && pagefind --site dist --glob 'docs/**/*.html' && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.12",
    "mermaid": "12.3.0",
    "reveal.js": "6.0.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/reveal.js": "5.2.2",
    "@types/three": "0.187.0",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "pagefind": "1.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
