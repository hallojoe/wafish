---
import Mark from "../components/Mark.astro";
import { url, github } from "../lib/site";
import "../styles/global.css";
const {
  title = "Wafish — An API gateway built for .NET",
  description = "An open-source .NET API gateway built on YARP. Add a web application firewall, rate limits, caching, and live route management.",
  section = "",
  wide = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141915" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("brand/favicon.svg")} />
    <link rel="apple-touch-icon" href={url("brand/apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(url("brand/social.png"), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[section, { wide }]}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href={url()} aria-label="Wafish home">
        <Mark />
        <span>
          Wafish<span class="wordmark-dot">.</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={url("#capabilities")}>Capabilities</a>
        <a
          href={url("docs/")}
          aria-current={section === "documentation" ? "page" : undefined}
        >
          Documentation
        </a>
        <a
          href={url("presentation/")}
          aria-current={section === "talk" ? "page" : undefined}
        >
          The talk <span aria-hidden="true">↗</span>
        </a>
        <a class="nav-github" href={github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="wordmark" href={url()}>
          <Mark size={28} />
          <span>Wafish.</span>
        </a>
        <p>Route traffic. Filter requests. Manage your .NET gateway.</p>
      </div>
      <div class="footer-links">
        <a href={url("docs/getting-started/")}>Get started</a>
        <a href={url("brand/")}>Brand assets</a>
        <a href={github}>Source / MIT</a>
        <span>1.0.0-rc.1</span>
      </div>
    </footer>
  </body>
</html>
