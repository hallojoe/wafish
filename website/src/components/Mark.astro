---
import master from "../../../brand/mark.svg?raw";
const { size = 38 } = Astro.props;
const paths = master
  .replace(/<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replaceAll("#e9eddf", "currentColor")
  .replaceAll("#d5f36b", "var(--signal)");
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
>
  <Fragment set:html={paths} />
</svg>
