---
import {
  journeyStages,
  journeyCases,
  journeyDetail,
  journeyDuration,
} from "../lib/request-journey";
import { url } from "../lib/site";
const initial = journeyDetail("forwarded", 0);
---

<section
  class="journey"
  data-journey
  data-case="forwarded"
  data-stage="0"
  data-playing="false"
  aria-labelledby="journey-title"
>
  <header class="journey-heading">
    <div>
      <p class="eyebrow">INSIDE THE GATEWAY / FOUR SHORT STORIES</p>
      <h2 id="journey-title">Follow the request.</h2>
      <p>One request. Different decisions. Watch where each path leads.</p>
    </div>
    <span class="mono journey-example">ILLUSTRATED MODEL</span>
  </header>

  <div
    class="journey-options"
    role="group"
    aria-label="Request scenario"
    hidden
  >
    {Object.entries(journeyCases).map(([key, example], index) => (
      <button type="button" data-journey-case={key} aria-pressed={index === 0}>
        <span class="mono" aria-hidden="true">
          0{index + 1}
        </span>
        <span>{example.label}</span>
        <span class="journey-duration mono" aria-hidden="true">
          {Math.round(journeyDuration(key as keyof typeof journeyCases) / 1000)}
          s
        </span>
      </button>
    ))}
  </div>

  <div class="journey-theater">
    <div class="journey-slate mono">
      <span data-journey-chapter>01 / FORWARD TO SERVICE</span>
      <span>GET /catalog/products</span>
    </div>
    <div
      class="journey-viewport"
      role="img"
      aria-label="A request moves from the client through routing, WAF, rate limit, cache, and YARP to a service."
    >
      <svg class="journey-fallback" viewBox="0 0 1000 360" aria-hidden="true">
        <defs>
          <pattern
            id="journey-grid"
            width="30"
            height="30"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="#48573c" />
          </pattern>
        </defs>
        <rect width="1000" height="360" fill="url(#journey-grid)" />
        <path d="M80 160H920" stroke="#728656" stroke-width="3" fill="none" />
        <path
          data-journey-return
          d="M920 160V280H80V160"
          stroke="#a6cbe3"
          stroke-width="3"
          fill="none"
          opacity=".25"
        />
        {["CLIENT", "ROUTE", "WAF", "LIMIT", "CACHE", "YARP", "SERVICE"].map(
          (label, i) => (
            <g data-journey-fallback-node={i}>
              <path
                d={`M${45 + i * 140} 130l35 -20 35 20v65l-35 20-35-20z`}
                fill="#293724"
                stroke="#7e9366"
              />
              <path
                d={`M${45 + i * 140} 130l35 20 35-20m-35 20v65`}
                stroke="#7e9366"
                fill="none"
              />
              <text
                x={80 + i * 140}
                y="96"
                fill="#d8e2cd"
                text-anchor="middle"
                font-family="monospace"
                font-size="15"
              >
                {label}
              </text>
            </g>
          ),
        )}
        <circle data-journey-packet cx="220" cy="160" r="10" fill="#d5f36b" />
        <text
          x="500"
          y="320"
          fill="#a6cbe3"
          text-anchor="middle"
          font-family="monospace"
          font-size="13"
        >
          RESPONSE TO CLIENT
        </text>
      </svg>
    </div>
    <div class="journey-shotline mono">
      <span>
        <i class="journey-packet-key"></i>{" "}
        <span data-journey-direction>REQUEST</span>
      </span>
      <span data-journey-progress>No upstream request yet</span>
    </div>
    <div class="journey-caption" aria-live="off" aria-atomic="true">
      <span class="journey-counter mono" data-journey-counter>
        01 / MATCH ROUTE
      </span>
      <h3 data-journey-title>{initial.title}</h3>
      <p data-journey-decision>{initial.decision}</p>
    </div>
  </div>

  <div class="journey-player" hidden>
    <div class="journey-transport">
      <button type="button" data-journey-play aria-label="Play stories">
        <span data-journey-play-icon aria-hidden="true">
          ▶
        </span>{" "}
        <span data-journey-play-label>Play</span>
      </button>
      <button
        type="button"
        data-journey-replay
        aria-label="Replay current story"
      >
        ↺ Replay
      </button>
      <span class="mono journey-clock" data-journey-clock>
        00:00 / 00:27
      </span>
      <button type="button" data-journey-advance>
        Next stage →
      </button>
    </div>
    <input
      type="range"
      data-journey-seek
      min="0"
      max={journeyDuration("forwarded")}
      step="100"
      value="0"
      aria-label="Seek current story"
      aria-valuetext="Match route"
    />
    <ol class="journey-timeline" aria-label="Request stages">
      {journeyStages.map((stage, index) => (
        <li
          data-journey-node={index}
          data-state={index === 0 ? "current" : "pending"}
        >
          <button
            type="button"
            data-journey-stage={index}
            aria-current={index === 0 ? "step" : undefined}
            aria-controls="journey-detail"
          >
            <span class="mono">0{index + 1}</span>
            <span>
              {stage.role === "CLIENT"
                ? "Response"
                : stage.role === "ROUTING"
                  ? "Route"
                  : stage.role === "RESPONSE CACHE"
                    ? "Cache"
                    : stage.role === "RATE LIMIT"
                      ? "Limit"
                      : stage.role}
            </span>
            <span class="journey-stage-state" data-journey-state>
              {index === 0 ? "Current" : "Upcoming"}
            </span>
          </button>
        </li>
      ))}
    </ol>
  </div>

  <details class="journey-details" id="journey-detail">
    <summary>
      Explore this decision <span aria-hidden="true">+</span>
    </summary>
    <div class="journey-detail-grid">
      <div>
        <p class="mono">WHAT HAPPENS</p>
        <p data-journey-text>{initial.text}</p>
        <a data-journey-doc href={url(`docs/${journeyStages[0].doc}`)}>
          Read the documentation ↗
        </a>
      </div>
      <div>
        <p class="mono">NEXT STEP</p>
        <p data-journey-next>{initial.next}</p>
      </div>
    </div>
  </details>
  <p class="journey-note">
    Example policies and outcomes. Actual execution depends on enabled plugins,
    their order, and route or cluster bindings.
  </p>
  <noscript>
    <p class="journey-note">
      WAF and rate-limit rejections return immediately. Cache hits skip
      forwarding. Otherwise, YARP contacts the service.
    </p>
  </noscript>
</section>
<script>
  import { mountJourney } from "../scripts/request-movie";
  document
    .querySelectorAll<HTMLElement>("[data-journey]")
    .forEach(mountJourney);
</script>
<style>
  .journey {
    padding: 30px 30px 18px;
  }
  .journey-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .journey-heading .eyebrow {
    font-size: 10px;
    margin-bottom: 12px;
  }
  .journey h2 {
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.045em;
  }
  .journey-heading p:last-child {
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
  }
  .journey-example {
    color: var(--muted);
    font-size: 9px;
    padding-top: 5px;
    white-space: nowrap;
  }
  .journey-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
  }
  .journey-options button {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 2px solid transparent;
    background: #141915;
    padding: 18px 16px;
    font-size: 12px;
    text-align: left;
  }
  .journey-options button:last-child {
    border-right: 0;
  }
  .journey-options .mono {
    font-size: 10px;
    color: var(--muted);
  }
  .journey-options button[aria-pressed="true"] {
    background: #293320;
    border-bottom-color: var(--signal);
    color: var(--signal);
  }
  .journey-options button:hover {
    background: #293320;
  }
  .journey-duration {
    margin-left: auto;
  }
  .journey-theater {
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 40%, #2d3924, #111710 75%);
    border: 1px solid var(--line);
    border-top: 0;
  }
  .journey-slate {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    position: absolute;
    top: 22px;
    left: 24px;
    right: 24px;
    z-index: 1;
    font-size: 10px;
    color: var(--muted);
    pointer-events: none;
  }
  .journey-slate > :first-child {
    color: var(--signal);
  }
  .journey-viewport {
    height: clamp(320px, 35vw, 460px);
    position: relative;
  }
  .journey-viewport :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .journey-fallback {
    width: 100%;
    height: 100%;
    padding: 48px 24px 0;
  }
  [data-renderer="webgl"] .journey-fallback {
    visibility: hidden;
  }
  .journey-shotline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: -8px 24px 0;
    position: relative;
    font-size: 9px;
    color: var(--muted);
  }
  .journey-shotline > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .journey-packet-key {
    height: 6px;
    width: 6px;
    background: var(--signal);
    display: inline-block;
    transform: rotate(45deg);
  }
  [data-stage="5"] .journey-packet-key {
    background: #a6cbe3;
  }
  .journey-caption {
    text-align: center;
    padding: 22px 24px 28px;
    min-height: 154px;
    background: linear-gradient(transparent, #10160ee6);
  }
  .journey-counter {
    font-size: 9px;
    color: var(--signal);
    letter-spacing: 0.08em;
  }
  .journey h3 {
    font-size: clamp(21px, 2.4vw, 30px);
    letter-spacing: -0.035em;
    margin: 10px 0;
    line-height: 1.2;
  }
  .journey-caption p {
    color: var(--muted);
    font-size: 14px;
  }
  .journey-player {
    background: #141915;
    border: 1px solid var(--line);
    border-top: 0;
    padding: 18px 22px 12px;
  }
  .journey-transport {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .journey-transport button {
    padding: 9px 12px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 12px;
  }
  .journey-transport button:first-child {
    color: var(--signal);
    border-color: #809447;
    min-width: 92px;
  }
  .journey-transport button:hover {
    background: #293320;
  }
  .journey-transport button:last-child {
    margin-left: auto;
  }
  .journey-clock {
    color: var(--muted);
    font-size: 10px;
  }
  .journey-player input {
    display: block;
    width: 100%;
    margin: 16px 0 10px;
    accent-color: var(--signal);
    height: 16px;
    cursor: pointer;
  }
  .journey-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
  }
  .journey-timeline button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 10px 0;
    width: 100%;
    color: var(--muted);
    background: transparent;
    border: 0;
    font-size: 11px;
  }
  .journey-timeline .mono {
    font-size: 9px;
    opacity: 0.8;
  }
  [data-state="current"] button {
    color: var(--signal);
  }
  [data-state="skipped"] button {
    text-decoration: line-through;
    opacity: 0.5;
    cursor: default;
  }
  .journey-stage-state {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .journey-details {
    margin-top: 8px;
  }
  .journey-details summary {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    cursor: pointer;
    font-size: 13px;
    color: var(--muted);
    list-style: none;
  }
  .journey-details summary::-webkit-details-marker {
    display: none;
  }
  .journey-details summary span {
    color: var(--signal);
    font-size: 18px;
  }
  .journey-details[open] summary span {
    transform: rotate(45deg);
  }
  .journey-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 4px 0 24px;
  }
  .journey-detail-grid .mono {
    font-size: 9px;
    color: var(--signal);
    margin-bottom: 10px;
  }
  .journey-detail-grid p {
    font-size: 14px;
    color: var(--muted);
  }
  .journey-detail-grid a {
    display: inline-block;
    font-size: 12px;
    color: var(--signal);
    margin-top: 14px;
  }
  .journey-detail-grid a:hover {
    text-decoration: underline;
  }
  .journey-note {
    font-size: 10px;
    color: var(--muted);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 900px) {
    .journey {
      padding: 24px 18px 16px;
    }
    .journey-example,
    .journey-duration {
      display: none;
    }
    .journey-options button {
      padding: 15px 10px;
      gap: 8px;
      font-size: 11px;
    }
  }
  @media (max-width: 600px) {
    .journey {
      padding: 22px 12px 14px;
    }
    .journey-options {
      grid-template-columns: repeat(2, 1fr);
    }
    .journey-options button {
      padding: 12px 10px;
    }
    .journey-options button:nth-child(2) {
      border-right: 0;
    }
    .journey-heading {
      margin-bottom: 20px;
    }
    .journey-slate {
      left: 14px;
      right: 14px;
      top: 16px;
      font-size: 8px;
      flex-direction: column;
      gap: 7px;
    }
    .journey-viewport {
      height: 330px;
    }
    .journey-fallback {
      padding: 40px 6px 0;
    }
    .journey-shotline {
      margin: 0 14px;
      font-size: 8px;
    }
    .journey-shotline > span:last-child {
      text-align: right;
      max-width: 200px;
    }
    .journey-caption {
      padding: 24px 14px;
      min-height: 177px;
    }
    .journey-caption p {
      font-size: 12px;
    }
    .journey-player {
      padding: 12px 10px 8px;
    }
    .journey-transport {
      flex-wrap: wrap;
      gap: 6px;
    }
    .journey-transport button {
      padding: 9px 8px;
      font-size: 11px;
    }
    .journey-transport button:first-child {
      min-width: 76px;
    }
    .journey-clock {
      order: 4;
      width: 100%;
      text-align: right;
      margin-top: 6px;
    }
    .journey-timeline {
      gap: 2px;
    }
    .journey-timeline button {
      flex-direction: column;
      gap: 5px;
      font-size: 10px;
    }
    .journey-detail-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
