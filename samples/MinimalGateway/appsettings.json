{
  "Urls": "http://127.0.0.1:5080",
  "Gateway": {
    "Deployment": { "Mode": "ProxyOnly" },
    "Storage": { "Sqlite": { "ConnectionString": "Data Source=minimal-gateway.db" } }
  },
  "ReverseProxy": {
    "Routes": { "backend": { "ClusterId": "backend", "Match": { "Path": "/api/{**path}" } } },
    "Clusters": { "backend": { "Destinations": { "one": { "Address": "http://127.0.0.1:5090/" } } } }
  }
}
