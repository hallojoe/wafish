{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "EnableProxyResponseBodyCapture": false,
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": ""
      }
    },
    "Storage": {
      "Provider": "Sqlite", 
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "Prefix": "aneiang:",
        "Database": 0
      }
    },
    "Deployment": {
      "Mode": "AllInOne",
      "RequireLoopbackForDashboard": true,
      "HealthCheck": { "Enabled": true },
      "HotReload": { "Enabled": true }
    }
  },
  "AI": {
    "Enabled": false,
    "Provider": "deepseek",
    "ApiKey": "",
    "BaseUrl": "https://api.deepseek.com/v1",
    "ChatModel": "deepseek-v4-flash",
    "AnalysisModel": "deepseek-v4-flash",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "MaxHistory": 20,
    "ReasoningEffort": "auto",
    "UseCache": true,
    "BgAnalysis": false,
    "EnhanceNotif": false,
    "Fallback": {
      "Enabled": false,
      "Provider": "",
      "ApiKey": "",
      "BaseUrl": "",
      "Model": ""
    },
    "McpServer": {
      "Enabled": false,
      "Port": 8090
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Gateway": { "Url": "http://127.0.0.1:5200" },
      "Grpc": { "Url": "http://127.0.0.1:5201", "Protocols": "Http2" }
    }
  }
}
