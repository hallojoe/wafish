{
  "_comment": "Scenario 2: One process with two ports. Proxy on port 80; local dashboard on port 5000.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Proxy": {
        "Url": "http://0.0.0.0:80",
        "Protocols": "Http1AndHttp2"
      },
      "Dashboard": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "Gateway": {
    "Deployment": {
      "Mode": "Split",
      "EndpointRoles": {
        "Proxy": "Proxy",
        "Dashboard": "Dashboard"
      },
      "RequireLoopbackForDashboard": true
    },
    "Dashboard": {
      "RoutePrefix": "wafish",
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": ""
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  }
}
