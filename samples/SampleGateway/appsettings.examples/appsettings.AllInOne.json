{
  "_comment": "Scenario 1: Single-port AllInOne mode. Preserves existing behavior.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": ""
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  },
  "Urls": "http://0.0.0.0:5200"
}
