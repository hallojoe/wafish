{
  "_comment": "Scenario 5: Local dashboard on port 5000 without proxy forwarding. Supports a separate control plane.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Dashboard": { "Url": "http://127.0.0.1:5000" }
    }
  },
  "Gateway": {
    "Deployment": {
      "Mode": "DashboardOnly",
      "EndpointRoles": {
        "Dashboard": "Dashboard"
      },
      "RequireLoopbackForDashboard": true,
      "HealthCheck": {
        "Enabled": true,
        "Path": "/health",
        "ReadyPath": "/ready",
        "LivePath": "/live"
      },
      "HotReload": { "Enabled": true }
    },
    "Dashboard": {
      "RoutePrefix": "wafish",
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": "CHANGE_ME_STRONG_PASSWORD"
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db;Password=CHANGE_ME_DB_PASSWORD" }
    }
  }
}
