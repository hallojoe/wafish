{
  "_comment": "Scenario 3: One process with multiple ports. Proxy 80; dashboard 5000; health checks 5002.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Proxy":     { "Url": "http://0.0.0.0:80" },
      "Dashboard": { "Url": "http://127.0.0.1:5000" },
      "Health":    { "Url": "http://0.0.0.0:5002" }
    }
  },
  "Gateway": {
    "Deployment": {
      "Mode": "Split",
      "EndpointRoles": {
        "Proxy":     "Proxy",
        "Dashboard": "Dashboard",
        "Health":    "Health"
      },
      "RequireLoopbackForDashboard": true,
      "HealthCheck": {
        "Enabled":           true,
        "Path":              "/health",
        "ReadyPath":         "/ready",
        "LivePath":          "/live",
        "AllowedIps":        [],
        "CheckDatabase":     true,
        "CheckConfigLoaded": true
      },
      "HotReload": {
        "Enabled":              true,
        "DebounceMilliseconds": 500,
        "FallbackPollSeconds":  30,
        "RollbackOnFailure":    true,
        "MaxSnapshots":         5
      }
    },
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": ""
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  }
}
