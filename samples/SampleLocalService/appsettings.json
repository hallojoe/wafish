{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Registration": {
      "Enabled": false,
      "GatewayUrl": "http://localhost:5200",
      "RouteName": "sample-local-service",
      "MatchPaths": [
        "/api/local-service/{**catch-all}",
        "/api/local-service-alt/{**catch-all}"
      ],
      "LoadBalancingPolicy": "RoundRobin",
      "UseGrpcRegistration": true,
      "HeartbeatEnabled": true,
      "HeartbeatIntervalSeconds": 10
    }
  },
  "Urls": "http://127.0.0.1:5001"
}
