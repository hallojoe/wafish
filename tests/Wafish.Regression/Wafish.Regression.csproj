<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/SampleDiscoveryCatalog/SampleDiscoveryCatalog.csproj" />
    <ProjectReference Include="../../samples/SampleFaultProxy/SampleFaultProxy.csproj" />
    <ProjectReference Include="../../samples/SampleLocalService/SampleLocalService.csproj" />
    <Compile Include="../../Wafish.AppHost/TopologyState.cs" Link="Samples/TopologyState.cs" />
    <Compile Include="../../Wafish.AppHost/SonarQubeHealthCheck.cs" Link="Samples/SonarQubeHealthCheck.cs" />
    <Compile Include="../../samples/SampleGateway/OperatorUrl.cs" Link="Samples/OperatorUrl.cs" />
    <Compile Include="../Wafish.Performance/Shared/*.cs" Link="Performance/%(Filename)%(Extension)" />
    <Compile Include="../Shared/RegressionReport.cs" Link="RegressionReport.cs" />
    <Compile Include="../Shared/RegressionCaseRegistry.cs" Link="RegressionCaseRegistry.cs" />
    <None Update="contracts/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures/waf/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures/storage/*.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Wafish.ReactUi.Host/Wafish.ReactUi.Host.csproj" />
    <ProjectReference Include="../Fixtures/Wafish.CollectiblePlugin/Wafish.CollectiblePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Wafish.Storage.Tool/Wafish.Storage.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Wafish.ReactUi/Wafish.ReactUi.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <ProjectReference Include="..\..\src\Wafish\Wafish.csproj" />
    <ProjectReference Include="..\..\src\Wafish.Administration\Wafish.Administration.csproj" />
    <ProjectReference Include="..\..\src\Wafish.Storage.Sqlite\Wafish.Storage.Sqlite.csproj" />
  </ItemGroup>
</Project>
