<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/RegressionReport.cs" Link="RegressionReport.cs" />
    <Compile Include="../Shared/RegressionCaseRegistry.cs" Link="RegressionCaseRegistry.cs" />
    <None Update="contracts/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures/storage/*.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fixtures/Wafish.CollectiblePlugin/Wafish.CollectiblePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Wafish.Storage.Tool/Wafish.Storage.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Wafish.ReactUi/Wafish.ReactUi.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <ProjectReference Include="..\..\src\Wafish\Wafish.csproj" />
    <ProjectReference Include="..\..\src\Wafish.Administration\Wafish.Administration.csproj" />
    <ProjectReference Include="..\..\src\Wafish.Storage.Sqlite\Wafish.Storage.Sqlite.csproj" />
  </ItemGroup>
</Project>
